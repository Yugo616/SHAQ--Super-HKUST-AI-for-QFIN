{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHAQ Daily Oracle DomainReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "as_of_et", "horizon", "availability", "verdict", "component_type", "thesis", "antithesis", "unknowns", "invalidation", "evidence_ids", "lineage_root_ids"],
  "properties": {
    "domain": {"enum": ["market", "relationships", "event", "capital", "derivatives", "price_volume"]},
    "as_of_et": {"type": "string", "format": "date-time"},
    "horizon": {"const": "official_US_regular_session_open_to_close"},
    "availability": {"enum": ["available", "no_data", "not_entitled", "provider_error"]},
    "verdict": {"enum": ["bullish", "bearish", "neutral", "not_applicable", "unavailable"]},
    "component_type": {"enum": ["market_beta", "industry_spillover", "company_event", "capital_flow", "derivatives_distribution", "price_volume_state"]},
    "thesis": {"type": "string", "minLength": 1},
    "antithesis": {"type": "string", "minLength": 1},
    "unknowns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "invalidation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "lineage_root_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "anyOf": [
    {
      "properties": {
        "availability": {"const": "available"},
        "verdict": {"enum": ["bullish", "bearish", "neutral", "not_applicable"]}
      }
    },
    {
      "properties": {
        "availability": {"enum": ["no_data", "not_entitled", "provider_error"]},
        "verdict": {"const": "unavailable"}
      }
    }
  ]
}
